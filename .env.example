PORT=10000
FRONTEND_ORIGIN=https://smart-mine-v2-balanced.vercel.app
AUTH_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only durable workflow storage. Supabase requires the additive workflow migration.
WORKFLOW_STORE_PROVIDER=file
WORKFLOW_STORE_DIRECTORY=.runtime/workflows
ROOFRISK_ENTERPRISE_PASSWORD_HASH=
ROOFRISK_REGULATOR_PASSWORD_HASH=
ROOFRISK_EXPERT_PASSWORD_HASH=
ROOFRISK_ADMIN_PASSWORD_HASH=
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
